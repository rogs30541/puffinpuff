{
  "name": "puffinpuff",
  "productName": "海鸚泡芙 PuffinPuff",
  "version": "0.9.1",
  "description": "一次發布到 YouTube Shorts、FB Reels、IG Reels 的桌面工具",
  "main": "./out/main/index.js",
  "author": "VVLEE",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "electron-vite build && electron-builder --win",
    "release:win": "npm run build:win && node scripts/post-release.cjs",
    "git:push": "node scripts/post-release.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@mantine/core": "^7.13.4",
    "@mantine/dates": "^7.17.8",
    "@mantine/dropzone": "^7.17.8",
    "@mantine/hooks": "^7.13.4",
    "@mantine/notifications": "^7.13.4",
    "@tabler/icons-react": "^3.19.0",
    "axios": "^1.16.1",
    "csv-parse": "^5.6.0",
    "dayjs": "^1.11.20",
    "electron-context-menu": "^3.6.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "googleapis": "^144.0.0",
    "node-schedule": "^2.1.1",
    "react": "^18.3.1",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^18.3.11",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^2.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
